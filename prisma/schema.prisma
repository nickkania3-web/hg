generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  sport     String
  league    String
  createdAt DateTime @default(now())

  barLinks      TeamBarLink[]
  verifications Verification[]
  followedBy    FanTeamFollow[]

  @@unique([name, sport])
}

model Bar {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  lat         Float
  lng         Float
  tvCount     Int?
  soundPolicy String?
  capacity    Int?
  createdAt   DateTime @default(now())

  barLinks      TeamBarLink[]
  verifications Verification[]
  favoritedBy   FanBarFavorite[]

  @@index([city])
}

// Core many-to-many: which bars are "home" for which teams, with a rolled-up count
model TeamBarLink {
  id                String   @id @default(cuid())
  teamId            String
  barId             String
  verificationCount Int      @default(0)
  updatedAt         DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])
  bar  Bar  @relation(fields: [barId], references: [id])

  @@unique([teamId, barId])
}

// Individual check-ins; rolls up into TeamBarLink.verificationCount
model Verification {
  id        String   @id @default(cuid())
  fanId     String
  teamId    String
  barId     String
  note      String?
  createdAt DateTime @default(now())

  fan  Fan  @relation(fields: [fanId], references: [id])
  team Team @relation(fields: [teamId], references: [id])
  bar  Bar  @relation(fields: [barId], references: [id])

  @@index([teamId, barId])
  @@index([fanId, teamId, barId, createdAt])
}

model Fan {
  id          String   @id @default(cuid())
  deviceId    String   @unique
  handle      String   @unique
  displayName String?
  createdAt   DateTime @default(now())

  verifications Verification[]
  teamFollows   FanTeamFollow[]
  barFavorites  FanBarFavorite[]
  following     FanFollow[] @relation("FollowerFan")
  followers     FanFollow[] @relation("FolloweeFan")
}

// One-directional fan-to-fan follow (no approval flow)
model FanFollow {
  id            String   @id @default(cuid())
  followerFanId String
  followeeFanId String
  createdAt     DateTime @default(now())

  follower Fan @relation("FollowerFan", fields: [followerFanId], references: [id])
  followee Fan @relation("FolloweeFan", fields: [followeeFanId], references: [id])

  @@unique([followerFanId, followeeFanId])
  @@index([followeeFanId])
}

// A fan following a team ("my teams")
model FanTeamFollow {
  id        String   @id @default(cuid())
  fanId     String
  teamId    String
  createdAt DateTime @default(now())

  fan  Fan  @relation(fields: [fanId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([fanId, teamId])
}

// A bar a fan has explicitly starred/saved, independent of verification history
model FanBarFavorite {
  id        String   @id @default(cuid())
  fanId     String
  barId     String
  createdAt DateTime @default(now())

  fan Fan @relation(fields: [fanId], references: [id])
  bar Bar @relation(fields: [barId], references: [id])

  @@unique([fanId, barId])
}
