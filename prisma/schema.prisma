generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  sport     String
  league    String
  createdAt DateTime @default(now())

  barLinks      TeamBarLink[]
  verifications Verification[]
  followedBy    FanTeamFollow[]
  watchParties  WatchParty[]

  @@unique([name, sport])
}

model Bar {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  lat         Float
  lng         Float
  tvCount     Int?
  soundPolicy String?
  capacity    Int?
  createdAt   DateTime @default(now())

  barLinks      TeamBarLink[]
  verifications Verification[]
  favoritedBy   FanBarFavorite[]
  watchParties  WatchParty[]

  @@index([city])
}

// Core many-to-many: which bars are "home" for which teams, with a rolled-up count
model TeamBarLink {
  id                String   @id @default(cuid())
  teamId            String
  barId             String
  verificationCount Int      @default(0)
  updatedAt         DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])
  bar  Bar  @relation(fields: [barId], references: [id])

  @@unique([teamId, barId])
}

// Individual check-ins; rolls up into TeamBarLink.verificationCount
model Verification {
  id        String   @id @default(cuid())
  fanId     String
  teamId    String
  barId     String
  note      String?
  createdAt DateTime @default(now())

  fan  Fan  @relation(fields: [fanId], references: [id])
  team Team @relation(fields: [teamId], references: [id])
  bar  Bar  @relation(fields: [barId], references: [id])

  @@index([teamId, barId])
  @@index([fanId, teamId, barId, createdAt])
}

model Fan {
  id          String   @id @default(cuid())
  deviceId    String   @unique
  displayName String?
  createdAt   DateTime @default(now())

  verifications      Verification[]
  teamFollows        FanTeamFollow[]
  barFavorites       FanBarFavorite[]
  hostedWatchParties WatchParty[]    @relation("HostedWatchParties")
  rsvps              RSVP[]
}

// A fan following a team ("my teams")
model FanTeamFollow {
  id        String   @id @default(cuid())
  fanId     String
  teamId    String
  createdAt DateTime @default(now())

  fan  Fan  @relation(fields: [fanId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([fanId, teamId])
}

// A bar a fan has explicitly starred/saved, independent of verification history
model FanBarFavorite {
  id        String   @id @default(cuid())
  fanId     String
  barId     String
  createdAt DateTime @default(now())

  fan Fan @relation(fields: [fanId], references: [id])
  bar Bar @relation(fields: [barId], references: [id])

  @@unique([fanId, barId])
}

// A fan-hosted watch party for a team+bar+date/time. "Upcoming" vs "Past" is
// computed from dateTime at query time, not stored.
model WatchParty {
  id             String   @id @default(cuid())
  teamId         String
  barId          String
  city           String
  dateTime       DateTime
  note           String?
  createdByFanId String
  createdAt      DateTime @default(now())

  team      Team   @relation(fields: [teamId], references: [id])
  bar       Bar    @relation(fields: [barId], references: [id])
  createdBy Fan    @relation("HostedWatchParties", fields: [createdByFanId], references: [id])
  rsvps     RSVP[]

  @@index([city, dateTime])
  @@index([teamId])
}

// A fan's RSVP to a watch party
model RSVP {
  id           String   @id @default(cuid())
  fanId        String
  watchPartyId String
  createdAt    DateTime @default(now())

  fan        Fan        @relation(fields: [fanId], references: [id])
  watchParty WatchParty @relation(fields: [watchPartyId], references: [id])

  @@unique([fanId, watchPartyId])
}
